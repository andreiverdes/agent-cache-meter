    "statusline",
    "status-line",
    "prompt-cache",
    "anthropic",
    "tern"
  ],
  "license": "MIT",
  "author": "Andrei Verdes (https://github.com/andreiverdes)",
  "homepage": "https://github.com/andreiverdes/agent-cache-meter/tree/main/claude-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreiverdes/agent-cache-meter.git",
    "directory": "claude-code"
  },
  "bugs": {
    "url": "https://github.com/andreiverdes/agent-cache-meter/issues"
  },
  "type": "module",
  "bin": {
    "claude-cache-meter": "dist/claude-cache-meter.js"
  },
  "files": [
    "dist/claude-cache-meter.js"
  ],
  "engines": {
    "node": ">=18"
